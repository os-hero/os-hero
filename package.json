{
  "name": "os-hero",
  "version": "1.5.1",
  "description": "OS Hero tray/menu bar pixel character app",
  "main": "src/main/main.js",
  "author": "The Mercenary",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:native": "node scripts/build-native.js",
    "prestart": "npm run build:native",
    "predev": "npm run build:native",
    "prepack": "npm run build:native",
    "predist": "npm run build:native",
    "predist:mac": "npm run build:native",
    "pretest:electron": "npm run build:native",
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "assets:backgrounds": "node scripts/generate-backgrounds.js",
    "test:electron": "node scripts/qa-runner.js",
    "test:packaged": "node scripts/qa-package.js",
    "cleanup:local": "node scripts/cleanup-local.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "release:mac": "node scripts/release-mac.js",
    "verify:release": "node scripts/release-feed.js",
    "deploy:updates": "node scripts/deploy-updates.js"
  },
  "dependencies": {
    "electron-updater": "6.8.3",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "26.6.0",
    "js-yaml": "4.1.1",
    "semver": "7.8.1"
  },
  "build": {
    "appId": "com.themercenary.oshero",
    "productName": "OS Hero",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "en",
      "en-US",
      "en_FEMININE",
      "en_MASCULINE",
      "en_NEUTER",
      "ko",
      "ko_FEMININE",
      "ko_MASCULINE",
      "ko_NEUTER",
      "zh-CN",
      "zh_CN",
      "zh_CN_FEMININE",
      "zh_CN_MASCULINE",
      "zh_CN_NEUTER"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://os-hero.github.io/updates/"
      }
    ],
    "files": [
      "package.json",
      "src/**/*",
      "public/**/*"
    ],
    "mac": {
      "artifactName": "OS-Hero-${version}-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "extraResources": [
        {
          "from": "build/native/oshero-outside-click",
          "to": "native/oshero-outside-click"
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
